rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBornilAdmin() {
      return signedIn() && (
        request.auth.token.email.lower() == 'bornilmahmud56@gmail.com' ||
        request.auth.token.email.lower() == 'bonrilmahmud56@gmail.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        isBornilAdmin() ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    function isModerator() {
      return signedIn() && (
        isAdmin() ||
        (hasUserDoc() && getUserData().role == 'moderator')
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsNewDoc() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    function ownsExistingDoc() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // User profiles: default role 'customer', only admin can promote to 'moderator' or 'admin'
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn() && userId == request.auth.uid && (
        (isBornilAdmin() && request.resource.data.role == 'admin') ||
        (!isBornilAdmin() && (request.resource.data.role == 'customer' || !('role' in request.resource.data)))
      );

      allow update: if isAdmin() || (
        isOwner(userId) && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isAdmin();
    }

    // Landing page & site CMS configuration
    match /landing_config/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /media_library/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Operational records: RFQs, Inquiries, Samples, Job applications
    match /rfqs/{docId} {
      allow create: if ownsNewDoc() || signedIn();
      allow read: if ownsExistingDoc() || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /contact_inquiries/{docId} {
      allow create: if ownsNewDoc() || signedIn() || request.resource.data.email is string;
      allow read: if ownsExistingDoc() || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /sample_requests/{docId} {
      allow create: if ownsNewDoc() || signedIn();
      allow read: if ownsExistingDoc() || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /job_applications/{docId} {
      allow create: if ownsNewDoc() || signedIn();
      allow read: if ownsExistingDoc() || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read, create: if isModerator();
      allow update, delete: if false;
    }

    match /ai_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
